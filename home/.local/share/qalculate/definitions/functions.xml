<?xml version="1.0"?>
<QALCULATE version="4.7.0">
  <category>
    <title>Logical</title>
    <function>
      <title>Get Bit Indices</title>
      <names>r:tobits</names>
      <description>Gets the indices of the set bits in the binary representation of a number, such that x = sum(2^i where i &#x2208; tobits(x)).</description>
      <subfunction precalculate="true">floor(log2(max(1, \x)))</subfunction>
      <expression>select(genvector(y, 0, \1, 1, y, 1), \x &amp; 1 &lt;&lt; x, x)</expression>
      <argument type="integer" index="1">
        <title>Number</title>
        <min>0</min>
      </argument>
    </function>
    <function>
      <title>Set Bit Indices</title>
      <names>frombits</names>
      <expression>add(1 &lt;&lt; \x)</expression>
      <argument type="vector" index="1">
        <title>Indices</title>
      </argument>
    </function>
  </category>
  <category>
    <title>Combinatorics</title>
    <function>
      <title>Multinomial Coefficient</title>
      <names>r:multinomial</names>
      <description>The coefficient of the x_1^{k_1} * x_2^{k_2} * ... term of (x_1 + x_2 + ...)^n.</description>
      <example>multinomial(2, 3, 0) = 10</example>
      <expression>total(\x)!/csum(1,0,1,\a*\b,\a,\b,factorial(\x))</expression>
      <argument type="vector" index="1">
        <title>Powers</title>
      </argument>
    </function>
  </category>
  <category>
    <title>Matrices &amp; Vectors</title>
    <function>
      <title>Vector Difference</title>
      <names>r:vecdiff</names>
      <description>Calculate the difference between adjacent elements.</description>
      <example>vecdiff([1,2,4])</example>
      <expression>slice(\x,2,-1) - slice(\x,1,-2)</expression>
      <argument type="vector" index="1">
        <title>x</title>
      </argument>
    </function>
  </category>
</QALCULATE>
